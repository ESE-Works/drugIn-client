{
  "expo": {
    "name": "drugIn-client",
    "slug": "drugIn-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.drugInclient"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ese.seulchung"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "2ee507a2202ec9730445ef7c57a2bfaa",
          "kotlinVersion": "2.1.0",
          "overrideKakaoSDKVersion": ""
        }
      ],
      "expo-web-browser",
      "./plugins//withKakaoMavenRepo.js"
    ]
  }
}
